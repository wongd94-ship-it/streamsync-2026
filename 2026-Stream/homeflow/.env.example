# StreamSync — local development environment
#
# Copy this file to `.env` (same directory) and fill in your own values.
# `.env` is gitignored — never commit real keys.
#
# After editing .env, restart Expo with: npx expo start --clear

# ─── Backend selection ────────────────────────────────────────────────
EXPO_PUBLIC_BACKEND_TYPE=local

# Cloud Functions base URL (used by the support-chat + smart-on-fhir + claim
# participant clients). Leave blank to use the project default
# https://us-central1-<projectId>.cloudfunctions.net.
EXPO_PUBLIC_FUNCTIONS_BASE_URL=

# SMART on FHIR config (optional — leave blank if you don't need SMART)
EXPO_PUBLIC_SMART_HEALTH_SYSTEMS_JSON=
EXPO_PUBLIC_EPIC_CLIENT_ID=

# ─── Firebase Web SDK config — REQUIRED ───────────────────────────────
# Copy these from your Firebase project's settings page:
#   Firebase Console → Project settings → General → Your apps →
#   Firebase SDK snippet → Config
#
# As of 2026-05-10 these values are no longer baked into the app source as
# fallbacks; missing any of them will throw a clear error at boot. The
# original literal-string defaults were removed after the API key leaked
# in git history; rotate + restrict any keys you place here in Google
# Cloud Console (HTTP referrer for web + iOS bundle id for mobile).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ─── Firebase Auth Emulator (local dev only) ──────────────────────────
# When true, the app points Firebase Auth + Firestore at local emulators —
# avoids the production API key's HTTP referer restrictions.
# Start emulators with: firebase emulators:start --only auth,firestore
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
