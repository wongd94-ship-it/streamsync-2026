# Backend Configuration
EXPO_PUBLIC_BACKEND_TYPE=local

# LLM Configuration
# Set to "true" to route LLM calls through Firebase Cloud Function (production).
# Set to "false" to call OpenAI directly from the client (development only).
EXPO_PUBLIC_USE_BACKEND_LLM=false
EXPO_PUBLIC_BACKEND_LLM_URL=
EXPO_PUBLIC_FUNCTIONS_BASE_URL=
EXPO_PUBLIC_SMART_HEALTH_SYSTEMS_JSON=
EXPO_PUBLIC_EPIC_CLIENT_ID=

# LLM API Keys (development only — must NOT ship in production bundle)
EXPO_PUBLIC_OPENAI_API_KEY=

# Firebase Auth Emulator (development only)
# When true, the app points Firebase Auth + Firestore at local emulators.
# Start them with: firebase emulators:start --only auth,firestore
# This avoids the `auth/requests-from-referer-<empty>-are-blocked` error
# caused by the production API key's HTTP referer restrictions.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
EXPO_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Production / TestFlight override: unrestricted or iOS-bundle-restricted API
# key. Leave blank to use the baked-in DEFAULT_FIREBASE_CONFIG. See
# docs/FIREBASE_AUTH_SETUP.md for the Google Cloud Console steps.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
